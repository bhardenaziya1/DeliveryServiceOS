# ---------------------------------------------------------------------------
# VendorOS - root environment template
#
#   cp .env.example .env
#
# The API loads this file (`.env.local` overrides `.env`) and validates every
# variable at boot via apps/api/src/config/env.schema.ts. An invalid or missing
# value aborts startup with an explicit message - it never silently defaults.
#
# docker-compose.yml also reads POSTGRES_* / *_PORT from this file.
# ---------------------------------------------------------------------------

# --- Runtime ---------------------------------------------------------------
# development | test | production
NODE_ENV=development
PORT=3000
# Mounted prefix for every route, including health and docs.
API_PREFIX=api/v1

# --- PostgreSQL ------------------------------------------------------------
# Must be a postgres:// or postgresql:// URL. Matches docker-compose defaults.
DATABASE_URL="postgresql://vendoros:vendoros@localhost:5432/vendoros?schema=public"
POSTGRES_USER=vendoros
POSTGRES_PASSWORD=vendoros
POSTGRES_DB=vendoros
POSTGRES_PORT=5432

# --- Redis -----------------------------------------------------------------
# Must be a redis:// or rediss:// URL.
REDIS_URL="redis://localhost:6379"
REDIS_PORT=6379

# --- Auth ------------------------------------------------------------------
# At least 32 characters. Generate one with: openssl rand -base64 48
# A placeholder value is rejected outright when NODE_ENV=production.
JWT_SECRET="local-development-only-secret-change-me-32+"
# Duration such as 30s, 15m, 8h, 7d.
JWT_EXPIRES_IN=8h

# --- HTTP ------------------------------------------------------------------
# Comma-separated list of allowed browser origins.
CORS_ORIGIN="http://localhost:5173"

# --- Observability ---------------------------------------------------------
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=debug
# Human-readable logs instead of JSON. Defaults to true only in development.
LOG_PRETTY=true
# Serve Swagger UI. Defaults to true outside production.
SWAGGER_ENABLED=true

# --- Frontend (apps/web, read by Vite at build time) -----------------------
VITE_API_BASE_URL=http://localhost:3000/api/v1
