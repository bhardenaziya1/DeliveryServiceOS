# ---------------------------------------------------------------------------
# VendorOS - root environment template
#
#   cp .env.example .env
#
# The API loads this file (`.env.local` overrides `.env`) and validates every
# variable at boot via apps/api/src/config/env.schema.ts. An invalid or missing
# value aborts startup with an explicit message - it never silently defaults.
#
# docker-compose.yml also reads POSTGRES_* / *_PORT from this file.
# ---------------------------------------------------------------------------

# --- Runtime ---------------------------------------------------------------
# development | test | production
NODE_ENV=development
PORT=3000
# Mounted prefix for every route, including health and docs.
API_PREFIX=api/v1

# --- PostgreSQL ------------------------------------------------------------
# Must be a postgres:// or postgresql:// URL. Matches docker-compose defaults.
DATABASE_URL="postgresql://vendoros:vendoros@localhost:5432/vendoros?schema=public"
POSTGRES_USER=vendoros
POSTGRES_PASSWORD=vendoros
POSTGRES_DB=vendoros
POSTGRES_PORT=5432

# --- Redis -----------------------------------------------------------------
# Must be a redis:// or rediss:// URL.
REDIS_URL="redis://localhost:6379"
REDIS_PORT=6379

# --- Auth ------------------------------------------------------------------
# At least 32 characters. Generate one with: openssl rand -base64 48
# A placeholder value is rejected outright when NODE_ENV=production.
JWT_SECRET="local-development-only-secret-change-me-32+"

# Access-token lifetime (30s, 15m, 8h, 7d). Kept short: a revoked session or a
# changed role only takes effect once the access token is re-issued, so this is
# the worst-case staleness window.
JWT_ACCESS_EXPIRES_IN=15m

# Refresh-token and session lifetime. Refresh tokens are single-use and rotate
# on every exchange; replaying a spent one revokes the whole session.
REFRESH_TOKEN_TTL_DAYS=7
# Used instead when the user ticks "keep me signed in". Must be >= the above.
REFRESH_TOKEN_REMEMBER_ME_TTL_DAYS=30

# One-time link lifetimes.
PASSWORD_RESET_TTL_MINUTES=30
EMAIL_VERIFICATION_TTL_HOURS=48
INVITATION_TTL_DAYS=7

# Brute-force protection: consecutive failures before the account locks, and
# for how long.
LOGIN_MAX_FAILED_ATTEMPTS=10
LOGIN_LOCKOUT_MINUTES=15

# --- Mail ------------------------------------------------------------------
# log  - writes the message (and its link) to the structured logger. This is
#        how invitation and password-reset links are read in development.
# noop - drops every message; for shared demo instances and load tests.
MAIL_DRIVER=log
MAIL_FROM="VendorOS <no-reply@vendoros.local>"

# Public base URL of the web app. Used to build the links inside emails.
APP_WEB_URL=http://localhost:5173

# --- HTTP ------------------------------------------------------------------
# Comma-separated list of allowed browser origins.
CORS_ORIGIN="http://localhost:5173"

# --- Observability ---------------------------------------------------------
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=debug
# Human-readable logs instead of JSON. Defaults to true only in development.
LOG_PRETTY=true
# Serve Swagger UI. Defaults to true outside production.
SWAGGER_ENABLED=true

# --- Frontend (apps/web, read by Vite at build time) -----------------------
VITE_API_BASE_URL=http://localhost:3000/api/v1
