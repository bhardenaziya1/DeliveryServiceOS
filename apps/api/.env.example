# The API reads the repository-root .env first (see /.env.example, which is the
# single template for the whole monorepo). This file is only needed when you
# want API-specific overrides, or when a deploy platform sets variables
# per-service. Values here take precedence over the root file.
#
#   cp apps/api/.env.example apps/api/.env

NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

DATABASE_URL="postgresql://vendoros:vendoros@localhost:5432/vendoros?schema=public"
REDIS_URL="redis://localhost:6379"

# At least 32 characters; generate with: openssl rand -base64 48
JWT_SECRET="local-development-only-secret-change-me-32+"
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_TTL_DAYS=7
REFRESH_TOKEN_REMEMBER_ME_TTL_DAYS=30

PASSWORD_RESET_TTL_MINUTES=30
EMAIL_VERIFICATION_TTL_HOURS=48
INVITATION_TTL_DAYS=7
LOGIN_MAX_FAILED_ATTEMPTS=10
LOGIN_LOCKOUT_MINUTES=15

# log | noop - see /.env.example for what each driver does.
MAIL_DRIVER=log
MAIL_FROM="VendorOS <no-reply@vendoros.local>"
APP_WEB_URL=http://localhost:5173

CORS_ORIGIN="http://localhost:5173"

LOG_LEVEL=debug
LOG_PRETTY=true
SWAGGER_ENABLED=true
